{
  "name": "dhvani-api",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "dev": "tsx --watch --env-file .env.dev src/index.ts",
    "dev:prod": "tsx --watch --env-file .env.prod src/index.ts",
    "start": "node --env-file .env.dev dist/index.js",
    "build": "tsc",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DesigningDhvaniApp/TESTAPI.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/DesigningDhvaniApp/TESTAPI/issues"
  },
  "homepage": "https://github.com/DesigningDhvaniApp/TESTAPI#readme",
  "description": "",
  "imports": {
    "#*": "./src/*"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "http-status-codes": "^2.3.0",
    "lodash": "^4.17.21",
    "luxon": "^3.6.0",
    "mongoose": "^8.13.1",
    "nodemailer": "^6.10.0",
    "winston": "^3.17.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.23.0",
    "@tsconfig/node23": "^23.0.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/lodash": "^4.17.16",
    "@types/luxon": "^3.4.2",
    "@types/node": "^22.13.14",
    "@types/nodemailer": "^6.4.17",
    "eslint": "^9.23.0",
    "eslint-plugin-perfectionist": "^4.10.1",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.0",
    "prettier": "^3.5.3",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.28.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint",
      "prettier --check"
    ],
    "*.{json,yml,yaml,md}": [
      "prettier --check"
    ]
  }
}
